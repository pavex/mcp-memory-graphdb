{
  "name": "mcp-memory-graphdb",
  "version": "0.1.0",
  "description": "MCP server — persistent LLM memory backed by DuckDB graph",
  "private": true,
  "type": "module",
  "main": "dist/mcp.js",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mcp-memory-graphdb": "dist/mcp.js"
  },
  "scripts": {
    "build": "npm run typecheck && node esbuild.config.mjs",
    "start": "node dist/mcp.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run test:run",
    "test:run": "node --import ./test/support/register.mjs --test \"test/**/*.test.ts\"",
    "style": "node scripts/restyle.mjs"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "js-yaml": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0"
  }
}
